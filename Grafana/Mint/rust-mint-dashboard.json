{
  "id": null,
  "uid": "rust-mint-service",
  "title": "Rust Mint Service",
  "tags": ["robotorq", "mint", "rust"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Service Status",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Uptime (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "mint_service_uptime_seconds{job='rust_mint'}",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "decimals": 0
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}
    },
    {
      "type": "stat",
      "title": "Last Batch Stake (RT JouleTorq Units)",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "mint_batch_last_stake{job='rust_mint'}",
          "legendFormat": "Stake"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          },
          "unit": "short",
          "decimals": 2
        }
      },
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 1}
    },
    {
      "type": "stat",
      "title": "Last Batch JouleTorq",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "mint_batch_last_jouletorq{job='rust_mint'}",
          "legendFormat": "JouleTorq"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          },
          "unit": "short",
          "decimals": 2
        }
      },
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 1}
    },
    {
      "type": "row",
      "title": "Buffers & Queues",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
    },
