  "links": [],
  "panels": [
      {
        "type": "row",
        "title": "Contract Lifecycle",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
      },
      {
        "type": "stat",
        "title": "Active Contracts",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "digger_contracts_active",
            "legendFormat": "Active"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            }
          }
        },
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 }
      },
      {
        "type": "stat",
        "title": "Contracts Created",
        "datasource": "Prometheus",
