{
  "id": null,
  "uid": "basic-vault-viewer",
  "title": "Basic Vault Viewer",
  "tags": ["robotorq", "vault"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 0,
  "refresh": "5s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Vault Metrics",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Certificates Stored",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "vault_cert_stored_total",
          "legendFormat": "Certificates"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 }
    },
    {
      "type": "stat",
      "title": "Available RoboStake",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "vault_available_robostake",
          "legendFormat": "Available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.01, "color": "green" }
            ]
          },
          "unit": "short",
          "decimals": 2
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 }
    },
    {
      "type": "stat",
      "title": "Deployed RoboStake",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "vault_deployed_robostake",
          "legendFormat": "Deployed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.01, "color": "green" }
            ]
          },
          "unit": "short",
          "decimals": 2
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 }
    },
    {
      "type": "graph",
      "title": "Stake Allocation Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "rate(vault_stake_allocated_total[1m])",
          "legendFormat": "Allocations/sec"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Rate (per second)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }
    },
    {
      "type": "graph",
      "title": "RoboStake Return Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "ff50x8bfhp7nke"
      },
      "targets": [
        {
          "expr": "rate(vault_robostake_returned_total[1m])",
          "legendFormat": "Returns/sec"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Rate (per second)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }
    },
    {
      "type": "row",
      "title": "Distostream",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "stat",
      "title": "Distostream Authorized",
      "datasource": { "type": "prometheus", "uid": "ff50x8bfhp7nke" },
      "targets": [ { "expr": "vault_distostream_authorized_total", "legendFormat": "authorized" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "decimals": 0 } },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 16 }
    },
    {
      "type": "stat",
      "title": "Distribution Ticks",
      "datasource": { "type": "prometheus", "uid": "ff50x8bfhp7nke" },
      "targets": [ { "expr": "vault_distostream_distribution_ticks_total", "legendFormat": "ticks" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "decimals": 0 } },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 16 }
    },
    {
      "type": "stat",
      "title": "Tick / Authorized Ratio",
      "datasource": { "type": "prometheus", "uid": "ff50x8bfhp7nke" },
      "targets": [ { "expr": "vault_distostream_distribution_ticks_total / ignoring() vault_distostream_authorized_total", "legendFormat": "ratio" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": 0, "color": "red" }, { "value": 1, "color": "green" } ] }, "unit": "none", "decimals": 2 } },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 16 }
    },
    {
      "type": "graph",
      "title": "Distostream Counters Over Time",
      "datasource": { "type": "prometheus", "uid": "ff50x8bfhp7nke" },
      "targets": [
        { "expr": "vault_distostream_authorized_total", "legendFormat": "authorized" },
        { "expr": "vault_distostream_distribution_ticks_total", "legendFormat": "ticks" }
      ],
      "yaxes": [ { "format": "short", "label": "Count" } ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 }
    }
  ]
}
