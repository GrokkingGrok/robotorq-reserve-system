{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "digger",
  "version": "0.1.0",
  "identifier": "com.robotorq.digger",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",

    "frontendDist":   "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Digger Dashboard",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
