# Dockerfile for running tests (keeps Go toolchain)
FROM golang:1.24-alpine

WORKDIR /app

# Install liboqs
RUN apk add --no-cache \
    git \
    cmake \
    ninja \
    build-base \
    pkgconfig \
    openssl-dev \
    linux-headers

# Build liboqs from source (minimal build for Falcon + SPHINCS+)
RUN git clone --depth 1 https://github.com/open-quantum-safe/liboqs.git /tmp/liboqs \
    && cd /tmp/liboqs && mkdir build && cd build \
    && cmake -GNinja \
        -DOQS_MINIMAL_BUILD="KEM_kyber_512;SIG_falcon_1024;SIG_sphincs_sha2_128f_simple" \
        -DOQS_USE_OPENSSL=ON .. \
    && ninja install \
    && rm -rf /tmp/liboqs

# Create fake liboqs-go.pc for pkg-config
RUN echo "prefix=/usr" > /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "exec_prefix=\${prefix}" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "libdir=\${exec_prefix}/lib" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "includedir=\${prefix}/include" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "Name: liboqs-go" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "Description: liboqs Go wrapper" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "Version: 0.11.0" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "Libs: -L\${libdir} -loqs -lcrypto" >> /usr/lib/pkgconfig/liboqs-go.pc \
    && echo "Cflags: -I\${includedir}" >> /usr/lib/pkgconfig/liboqs-go.pc

# Download Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Run tests by default
CMD ["go", "test", "-v", "./internal/crypto", "-run", "TestFalcon"]
